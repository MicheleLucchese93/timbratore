---
import "vanilla-cookieconsent/dist/cookieconsent.css";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const cookiePolicyUrl = `/${lang}/cookie-policy/`;
---

<div data-cookie-banner data-lang={lang} data-cookie-policy-url={cookiePolicyUrl} hidden></div>

<script>
  import * as CookieConsent from "vanilla-cookieconsent";
  // Static import on purpose: this module carries no posthog-js dependency, so
  // it costs a few hundred bytes and is available even on page loads where the
  // SDK itself is never fetched.
  import { erasePosthogStorage } from "../lib/posthog-storage";

  const node = document.querySelector<HTMLElement>("[data-cookie-banner]");
  const lang = node?.dataset.lang ?? "it";
  const cookiePolicyUrl = node?.dataset.cookiePolicyUrl ?? "/it/cookie-policy/";

  // PostHog is pulled in on demand, never on first paint: a visitor who refuses
  // (or has not yet answered) downloads none of the SDK. Keeping the module
  // handle lets a later withdrawal reach the instance that is already running.
  let analytics: typeof import("../lib/analytics") | null = null;

  // Fires on first consent, on every page load, and on every later change, so
  // one function is the whole state machine.
  async function syncAnalytics() {
    if (CookieConsent.acceptedCategory("analytics")) {
      analytics ??= await import("../lib/analytics");
      analytics.startAnalytics();
    } else if (analytics) {
      // SDK is running in this page: opt it out, then clear what it wrote.
      analytics.stopAnalytics();
    } else {
      // SDK was never loaded on this page load, so there is no instance to opt
      // out — but ph_* entries from an earlier accepted session can still be
      // sitting in storage. Without this sweep they would survive every future
      // visit, because autoClear only fires on the rejection itself.
      erasePosthogStorage();
    }
  }

  CookieConsent.run({
    guiOptions: {
      consentModal: { layout: "box inline", position: "bottom left" },
      preferencesModal: { layout: "box" },
    },
    categories: {
      necessary: { enabled: true, readOnly: true },
      analytics: {
        enabled: false,
        // Withdrawing consent has to actually remove what was set, not just
        // stop new events. `__ph_opt_in_out_*` is deliberately left alone —
        // it is the record of the refusal itself.
        autoClear: { cookies: [{ name: /^ph_/ }] },
      },
    },
    onConsent: syncAnalytics,
    onChange: syncAnalytics,
    language: {
      default: lang,
      translations: {
        it: {
          consentModal: {
            title: "Questo sito utilizza i cookie",
            description:
              'Utilizziamo cookie tecnici necessari al funzionamento del sito e, solo previo tuo consenso, cookie analitici per capire come viene utilizzato. <a href="' + cookiePolicyUrl + '">Cookie Policy</a>',
            acceptAllBtn: "Accetta tutto",
            acceptNecessaryBtn: "Solo necessari",
            showPreferencesBtn: "Personalizza",
          },
          preferencesModal: {
            title: "Preferenze cookie",
            acceptAllBtn: "Accetta tutto",
            acceptNecessaryBtn: "Solo necessari",
            savePreferencesBtn: "Salva preferenze",
            sections: [
              {
                title: "Cookie necessari",
                description: "Cookie essenziali per il funzionamento del sito. Non possono essere disattivati.",
                linkedCategory: "necessary",
              },
              {
                title: "Cookie analitici",
                description:
                  "Ci permettono di capire quali pagine vengono visitate e su quali elementi si clicca, e includono la registrazione anonima della sessione di navigazione (movimenti, clic e scorrimento), per migliorare il sito. Utilizziamo PostHog, con dati ospitati nell'Unione Europea (Francoforte). Non vengono creati profili utente e i valori digitati nei campi dei moduli sono sempre oscurati.",
                linkedCategory: "analytics",
              },
            ],
          },
        },
      },
    },
  });
</script>
