# Marketing website build-time configuration.
#
# Astro inlines PUBLIC_* variables at BUILD time, so these must be present when
# `npm run build` runs — including inside the Docker build on the server, where
# docker-compose passes them through as build args (see docker-compose.yml).
#
# Leave PUBLIC_POSTHOG_KEY empty to disable analytics entirely: the site then
# ships with no PostHog code path at all, which is the correct local-dev default.

# PostHog project API key ("Project API Key" in Project settings — the public
# phc_… one, NOT a personal API key).
PUBLIC_POSTHOG_KEY=

# EU cloud ingestion host. Only change this if you put a reverse proxy in front.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
